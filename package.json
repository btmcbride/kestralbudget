{
  "name": "kestralbudget",
  "version": "1.0.0",
  "description": "Local-first monthly budgeting app",
  "author": "Kestral Budget",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "node server.mjs",
    "build": "vite build",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run icons && npm run build && electron .",
    "desktop:dist": "npm run icons && npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.kestralbudget.desktop",
    "productName": "Kestral Budget",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "server.mjs",
      "assets/kestral-budget.ico",
      "dist/**/*",
      "!node_modules/better-sqlite3/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "assets/kestral-budget.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KestralBudget-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kestral Budget"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "sql.js": "^1.14.2"
  }
}
